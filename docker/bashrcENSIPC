# Trouver un (ou plusieurs) fichier(s) deca ou ass et lancer un test
function ftest() {
    [[ "${!#}" == -? ]] && { "$1" "${!#}"; return; }
    if [ $# -lt 2 ]; then
        echo "Usage: <alias> [options] <nom_du_fichier>"
        return 1
    fi

    # Premier argument
    local tool=$1
    shift


    # Dernier argument
    # local filename="${!#}"

    # Options 
    local options=""
    
    #fichiers
    local files=""

    for arg in "$@"; do
        if [[ "$arg" == -* ]]; then
            # Option
            options="$options $arg"
        else
            # Fichier
            local filepath=$(find "$GL/src/test/" -name "$arg" | head -n 1)
            
            if [ -z "$filepath" ]; then
                echo "Error: File '$arg' not found in $GL/src/test/"
                return 1
            fi
            
            # Chemin complet
            files="$files $filepath"
        fi
    done

    echo "Exécution de $tool $options $files"
    $tool $options $files
}

# Aliases

