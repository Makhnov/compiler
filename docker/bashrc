qbe_emit() {
  local -a opts=()
  local -a inputs=()

  while (($#)); do
    case "$1" in
      -t)
        opts+=("$1"); shift
        (($#)) || { echo "Erreur: -t attend une valeur." >&2; return 1; }
        opts+=("$1"); shift
        ;;
      -o)
        echo "Erreur: ne passe pas -o à qbe_emit (il est géré automatiquement)." >&2
        return 1
        ;;
      -*)
        opts+=("$1"); shift
        ;;
      *)
        inputs+=("$1"); shift
        ;;
    esac
  done

  ((${#inputs[@]})) || { echo "Erreur: aucun fichier en entrée." >&2; return 1; }

  local in out
  for in in "${inputs[@]}"; do
    out="${in%.*}.${QBE_OUT_EXT}"
    echo "Exécution de qbe ${opts[*]} -o $out $in"
    command qbe "${opts[@]}" -o "$out" "$in" || return $?
  done
}

__gl_default_ext() {
  case "$1" in
    decac|test_lex|test_synt|test_context) echo "deca" ;;
    ima)  echo "ass" ;;
    rars) echo "s" ;;
    qbe|qbe_emit) echo "qbe" ;;
    *)    echo "" ;;
  esac
}

__gl_resolve_file() {
  local tool="$1" token="$2" ext="$3"
  local base="$GL/src/test/deca"
  local -a matches=()

  if [[ -f "$token" ]]; then
    printf '%s\n' "$token"
    return 0
  fi

  if [[ "$token" == */* ]]; then
    if [[ -f "$base/$token" ]]; then
      printf '%s\n' "$base/$token"
      return 0
    fi
    echo "Erreur: Fichier '$token' introuvable (ni direct, ni sous $base)." >&2
    return 1
  fi

  if [[ -n "$ext" && "$token" != *.* ]]; then
    mapfile -d '' matches < <(find "$base" -type f \( -name "$token.$ext" -o -name "$token" \) -print0)
  else
    mapfile -d '' matches < <(find "$base" -type f -name "$token" -print0)
  fi

  case "${#matches[@]}" in
    0)
      echo "Erreur: Fichier '$token' introuvable dans $base." >&2
      return 1
      ;;
    1)
      printf '%s\n' "${matches[0]}"
      return 0
      ;;
    *)
      echo "Erreur: plusieurs fichiers correspondent à '$token' :" >&2
      printf '  %s\n' "${matches[@]}" >&2
      return 1
      ;;
  esac
}


ftest() {
  local tool="$1"
  shift || { echo "Usage: ftest <tool> [options] [fichiers...]" >&2; return 1; }

  local ext="$(__gl_default_ext "$tool")"
  local -a opts=()
  local -a files=()

  while (($#)); do
    case "$1" in
      -h|--help|-\?)
        opts+=("$1"); shift
        ;;
      --)
        shift
        while (($#)); do
          files+=("$(__gl_resolve_file "$tool" "$1" "$ext")") || return 1
          shift
        done
        break
        ;;
      -r|-ir|-t)
        opts+=("$1"); shift
        (($#)) || { echo "Erreur: option '${opts[-1]}' attend une valeur." >&2; return 1; }
        opts+=("$1"); shift
        ;;
      -*)
        opts+=("$1"); shift
        ;;
      *)
        files+=("$(__gl_resolve_file "$tool" "$1" "$ext")") || return 1
        shift
        ;;
    esac
  done

  echo "Exécution de $tool ${opts[*]} ${files[*]}"
  "$tool" "${opts[@]}" "${files[@]}"
}

