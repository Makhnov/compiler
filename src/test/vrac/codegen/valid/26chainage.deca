class Adder {
    int val = 0;

    Adder add(int x) {
        val = val + x;
        return this;
    }

    int getVal() {
        return val;
    }
}

{

    Adder a = new Adder();
    // 5 + 10 = 15
    if(a.add(5).add(10).getVal()==15)
    {
        println("OK");
    }else
    {
        println("KO");
        1/0;
    }
}