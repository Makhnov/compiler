// Description:
//    Test du masquage de champs (Shadowing).
//    Validation des valeurs via accesseurs et accès directs.
//
// Resultats:
//    OK
//
// Historique:
//    cree le 17/01/2026

class A {
    int x = 1;
    int getX() { return x; }
}
class B extends A {
    int x = 2; // Cache le x de A
    int getX() { return x; } // Redéfinit getX
}
{
    B b = new B();
    A a = b;
    
    // a.x -> 1 (statique A)
    // b.x -> 2 (statique B)
    // a.getX() -> 2 (dynamique B)
    // b.getX() -> 2 (dynamique B)
    
    if (a.x == 1 && b.x == 2 && a.getX() == 2 && b.getX() == 2) {
        println("OK");
    } else {
        println("KO");
        1/0;
    }
}