class Type{}

class Class {
    void Method(Type var){}
    void MethodFloat(float f){}
    void MethodInt(int i){}
    void MethodBoolean(boolean b){}
    void MethodClass(Class c){}
}

{
    int i;
    float f;
    boolean b;
    Class classe = new Class();
    Type var = new Type();

    classe.Method(var);

    classe.MethodFloat(1);
    classe.MethodFloat(1.5);
    classe.MethodFloat(f);

    classe.MethodInt(1);
    classe.MethodInt(i);

    classe.MethodBoolean(true);
    classe.MethodBoolean(b);

    classe.MethodClass(classe);
}