{
    // AND : true && (...) => le (...) doit être évalué => division par zéro attendue
    if (true && ((1 / 0) == 0)) {
        println(1);
    } else {
        println(0);
    }

    // OR : false || (...) => le (...) doit être évalué => division par zéro attendue
    if (false || ((1 / 0) == 0)) {
        println(1);
    } else {
        println(0);
    }
}
