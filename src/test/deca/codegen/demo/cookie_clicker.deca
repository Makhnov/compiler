class IO{
    int getOption(){
        int opt = readInt();
        while (opt<0 || opt>4){
            opt = readInt();
        }
        return opt;
    }
    void clear(){
        int n = 50;
        while (n>0){
            println();
            n = n -1;
        }
    }
