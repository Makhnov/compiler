{
    int x;
    int y;

    // Risque : commutation interdite
    x = 2;
    y = x + (x = 3);
    if (x != 3 || y != 5){println("KO"); 1/0;}
    println(y);
    println(x);

    // Risque: quel assign est pris en compte ?
    x = 2;
    x = x + (x = 3);
    println(x);
    if (x != 5){println("KO"); 1/0;}

    // cf. cas numéro 1
    x = 2;
    y = x - (x = 3);
    println(y);
    println(x);
    if (x != 3 || y != -1){println("KO"); 1/0;}

    // cf. cas numéro 2
    x = 2;
    x = x - (x = 3);
    println(x);
    if (x != -1){println("KO"); 1/0;}

    // cf. cas numéro 1
    x = 2;
    y = x * (x = 3);
    println(y);
    println(x);
    if (x != 3 || y != 6){println("KO"); 1/0;}

    // cf. cas numéro 2
    x = 2;
    x = x * (x = 3);
    println(x);
    if (x != 6){println("KO"); 1/0;}

    // cf. cas numéro 1
    x = 6;
    y = x / (x = 2);
    println(y);
    println(x);
    if (x != 2 || y != 3){println("KO"); 1/0;}

    // cf. cas numéro 2
    x = 12;
    y = x % (x = 5);
    println(y);
    println(x);
    if (x != 5 || y != 2){println("KO"); 1/0;}

    // cf. cas numéro 1
    x = 0;
    y = (x = 2) + (x = 3);
    println(y);
    println(x);
    if (x != 3 || y != 5){println("KO"); 1/0;}

    // cf. cas numéro 1
    x = 0;
    y = (x = 2) * (x = 3);
    println(y);
    println(x);
    if (x != 3 || y != 6){println("KO"); 1/0;}
}
