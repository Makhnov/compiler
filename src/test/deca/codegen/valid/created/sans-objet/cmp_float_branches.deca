{
    float f1 = 3.14;
    float f2 = 3.14;
    float f3 = 6.28;

    if (f1 == f2) {
        println("f1 == f2: true");
    } else {
        println("f1 == f2: false");
        1/0;
    }

    if (f1 != f3) {
        println("f1 != f3: true");
    } else {
        println("f1 != f3: false");
        1/0;
    }

    if (f1 < f3) {
        println("f1 < f3: true");
    } else {
        println("f1 < f3: false");
        1/0;
    }

    if (f3 > f1) {
        println("f3 > f1: true");
