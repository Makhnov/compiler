// Description:
//   Test des methodes de classe en Deca
//
// Resultats:
//    10
//    4
//    21
//    2
//    1
//    -7
//    -10
//    37
//    100
//    41
//    6.50000e+00
//    -3.50000e+00
//    7.50000e+00
//    3.00000e-01
//    -3.50000e+00
//    2.45000e+01
//    2.10000e+01
//    -8
//    5
//
// Historique:
//   cree le 20/12/2025

{
    int a;
    int b;
    int c;
    float x;
    float y;

    // Affectations simples
    a = 7;
    b = 3;
    x = 1.5;
    y = 5.0;

    // calculs simples
    println(a + b);                     // = 10
    println(a - b);                     // = 4
    println(a * b);                     // = 21
    println(a / b);                     // = 2     
    println(a % b);                     // = 1

    // Unaire -
    println(-a);                        // -a = -7
    println(-(a + b));                  // -(a + b) = -10

    // Avec et sans parenthèses
    println(a + b * 10);                // (a + (b*10)) = 37
    println((a + b) * 10);              // ((a+b) * 10) = 100
    c = (a + b) * (a - b) + (a % b);    // c = (10 * 4) + 1 = 41
    println(c);

    // Floats : + - * /
    println(x + y);                    // 6.5   
    println(x - y);                    // -3.5
    println(x * y);                    // 7.5
    println(x / y);                    // 0.3

    // priorité du unaire
    println(-(x + 0.25) * (y - 3.0));  // (-(1.5 + 0.25) * (5.0 - 3.0)) = -3.5

    // Mélanges (int + float)    
    println(0.5 * (a * a));            // (0.5 * 49) = 24.5    
    println((x + 2.0) * (a - 1));      // (3.5 * 6) = 21.0
    // associativité
    println(1 - 2 - 3 - 4);             // (((1-2)-3)-4) = -8
    println(20 / 2 / 2);                // ((20/2)/2) = 5
}
